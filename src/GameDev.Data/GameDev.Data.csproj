<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Project metadata -->
    <Description>EF Core DbContext and migrations configuration for GaDeMa Game Development Management Application</Description>
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Product>GaDeMa.Data</Product>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core project -->
    <ProjectReference Include="..\Gadema.Core\Gadema.Core.csproj" />
    
    <!-- EF Core packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    
    <!-- Optional: PostgreSQL for production -->
    <!-- <PackageReference Include="Microsoft.EntityFrameworkCore.PostgreSQL" Version="10.0.11" /> -->
  </ItemGroup>

</Project>