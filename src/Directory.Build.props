<Project>
  <PropertyGroup>
    <!-- Central Package Management - Single version definition per project -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Common properties for all Gadema projects -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Metadata -->
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Product>$(MSBuildProjectName)</Product>
  </PropertyGroup>

  <!-- Central Package References -->
  <ItemGroup>
    <!-- .NET Core / ASP.NET Core packages -->
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.12" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />

    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!-- Validation -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />

    <!-- Serialization / JSON -->
    <PackageReference Include="System.Text.Json" Version="10.0.11" />

    <!-- Testing -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Moq" Version="4.18.4" />

    <!-- PDF Generation -->
    <PackageReference Include="QuestPDF" Version="2026.7.3" />

    <!-- Google Auth -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />

    <!-- MudBlazor for WebApp -->
    <PackageReference Include="MudBlazor" Version="6.19.0" />
  </ItemGroup>
</Project>
