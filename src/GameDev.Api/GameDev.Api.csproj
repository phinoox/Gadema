<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    
    <!-- Project metadata -->
    <Description>ASP.NET Core Web API layer for GaDeMa Game Development Management Application</Description>
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Product>GaDeMa.Api</Product>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Data and Core projects -->
    <ProjectReference Include="..\GameDev.Data\GameDev.Data.csproj" />
    <ProjectReference Include="..\GameDev.Core\GameDev.Core.csproj" />
    
    <!-- EF Core packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    
    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.65.0" />
    
    <!-- PDF generation -->
    <PackageReference Include="QuestPDF" Version="2024.1.0" />
    
    <!-- Testing (optional) -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>