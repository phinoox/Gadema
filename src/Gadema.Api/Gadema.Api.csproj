<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    
    <!-- Project metadata -->
    <Description>ASP.NET Core Web API layer for GaDeMa Game Development Management Application</Description>
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Product>GaDeMa.Api</Product>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup>
  <StartupObject>Gadema.Api.Program</StartupObject>
</PropertyGroup>
  <ItemGroup>
  <InternalsVisibleTo Include="Gadema.Tests" />
</ItemGroup>   

  <ItemGroup>
    <!-- Reference to Data and Core projects -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.12" />
    <ProjectReference Include="../Gadema.Data/Gadema.Data.csproj" />
    <ProjectReference Include="..\Gadema.Core\Gadema.Core.csproj" />
    
    <!-- EF Core packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    
    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    
    <!-- PDF generation -->
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    
    <!-- Testing (optional) -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

</Project>