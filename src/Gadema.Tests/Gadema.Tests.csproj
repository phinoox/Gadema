<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Project metadata -->
    <Description>Unit and Integration tests for GaDeMa Game Development Management Application</Description>
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Product>GaDeMa.Tests</Product>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core, Api, and Data projects -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <ProjectReference Include="..\Gadema.Core\Gadema.Core.csproj" />
    <ProjectReference Include="..\Gadema.Api\Gadema.Api.csproj" />
    
    <!-- Testing frameworks -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Moq" Version="4.18.4" />
  </ItemGroup>

</Project>