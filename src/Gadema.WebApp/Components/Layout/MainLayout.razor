@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase



<div class="d-flex flex-column flex-md-row align-items-stretch min-vh-100">
    <div class="sidebar col-md-3 bg-light border-end" style="min-height: 100vh;">
        <SectionOutlet SectionName="NavMenu" @rendermode="@(new InteractiveServerRenderMode())"/>
        <NavMenu/>
    </div>

    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4" style="min-height: 100vh;">
        <div class="top-row ps-3 navbar navbar-dark bg-primary d-flex align-items-center">
            <a class="navbar-brand fw-bold ms-2 me-auto text-white" href="">GaDeMa</a>
            <UserMenu/>
        </div>

        <article class="content px-4 pt-4">
            <h1>@Body</h1>
        </article>
    </main>
</div>

<ReconnectModal />
