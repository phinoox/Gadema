<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    
    <!-- Project metadata -->
    <Description>Blazor Server App layer for GaDeMa Game Development Management Application</Description>
    <Authors>GaDeMa Team</Authors>
    <Company>GaDeMa</Company>
    <Product>GaDeMa.WebApp</Product>
    <Copyright>© 2024 GaDeMa Team. All rights reserved.</Copyright>
    <Version>0.1.0</Version>
    
    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Api and Core projects -->
    <ProjectReference Include="..\GameDev.Api\GameDev.Api.csproj" />
    <ProjectReference Include="..\GameDev.Core\GameDev.Core.csproj" />
    
    <!-- Blazor components -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.3" />
    <PackageReference Include="MudBlazor" Version="6.19.0" />
  </ItemGroup>

</Project>