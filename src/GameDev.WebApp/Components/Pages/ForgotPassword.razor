@page "/forgot-password"

<PageTitle>Forgot Password - GaDeMa</PageTitle>

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="card-body p-5">
                    <!-- Logo -->
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-key" style="font-size: 2.5rem; color: #0d6efd;"></i>
                        </div>
                        <h3>Reset Password</h3>
                        <p class="text-muted">Enter your email to receive a password reset link</p>
                    </div>

                    <!-- Forgot Password Form -->
                    <form id="forgotPasswordForm" method="post">
                        <div class="mb-4">
                            <label for="email" class="form-label text-muted">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-secondary">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" 
                                       class="form-control border-start-0 border-secondary form-control-lg" 
                                       id="email" 
                                       name="Email" 
                                       placeholder="your.email@example.com" />
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <button type="submit" class="btn btn-primary w-100 mb-3 py-2">
                            Send Reset Link
                        </button>

                        <!-- Back to Sign In -->
                        <a href="/signin" class="btn btn-outline-secondary w-100">
                            Back to Sign In
                        </a>
                    </form>

                    <!-- Success Message (will show after successful request) -->
                    @if (!string.IsNullOrEmpty(SuccessMessage))
                    {
                        <div class="alert alert-success mt-3" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            @SuccessMessage
                        </div>
                    }

                    <!-- Error Message -->
                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Footer Links -->
            <div class="text-center mt-4 text-muted small">
                <a href="#" class="text-decoration-none">Privacy Policy</a> | 
                <a href="#" class="text-decoration-none">Terms of Service</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string SuccessMessage { get; set; } = "";
    private string? ErrorMessage { get; set; }

    protected  async Task OnPostAsync()
    {
        // TODO: Integrate with user management service for password reset
        
        try
        {
            // Simulate sending reset email
            SuccessMessage = "Password reset link has been sent to your email address. Please check your inbox.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
            StateHasChanged();
        }
    }
}
