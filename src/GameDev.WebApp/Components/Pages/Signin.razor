@page "/signin"
@inject NavigationManager Navigation


<PageTitle>Sign In - GaDeMa</PageTitle>

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0 rounded-3 overflow-hidden">
                <div class="card-body p-5">
                    <!-- Logo/Brand -->
                    <div class="text-center mb-4">
                        <div class="mb-3">
                            <i class="bi bi-controller" style="font-size: 3rem; color: #0d6efd;"></i>
                        </div>
                        <h3>Welcome to GaDeMa</h3>
                        <p class="text-muted">Game Development Management System</p>
                    </div>

                    <!-- Sign In Form -->
                    <form id="signinForm" method="post">
                        <div class="mb-4">
                            <label for="email" class="form-label text-muted">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-primary">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="email" 
                                       class="form-control border-start-0 border-secondary" 
                                       id="email" 
                                       name="Email" 
                                       placeholder="your.email@example.com" 
                                       autocomplete="email" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label text-muted">Password</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="password" 
                                   name="Password" 
                                   placeholder="Enter your password" />
                        </div>

                        <!-- Remember Me -->
                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" />
                                <label class="form-check-label text-muted" for="rememberMe">
                                    Remember me for 30 days
                                </label>
                            </div>
                            <a href="/forgot-password" class="text-decoration-none small">Forgot password?</a>
                        </div>

                        <!-- Sign In Button -->
                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            Sign In
                        </button>
                    </form>

                    <!-- Divider -->
                    <hr />

                    <!-- Quick Links -->
                    <div class="text-center my-4">
                        <p class="text-muted small mb-3">Or continue with</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="#" class="btn btn-outline-secondary btn-sm" onclick="alert('GitHub authentication not yet configured')">
                                GitHub
                            </a>
                            <a href="#" class="btn btn-outline-danger btn-sm" onclick="alert('Google authentication not yet configured')">
                                Google
                            </a>
                        </div>
                    </div>

                    <!-- Don't Have Account -->
                    <div class="text-center mt-4">
                        <p class="text-muted small mb-0">
                            Don't have an account? 
                            <a href="/register" class="fw-bold text-decoration-none">Register here</a>
                        </p>
                    </div>

                    <!-- Error Message -->
                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <!-- Footer Links -->
            <div class="text-center mt-4 text-muted small">
                <a href="#" class="text-decoration-none">Privacy Policy</a> | 
                <a href="#" class="text-decoration-none">Terms of Service</a> | 
                <a href="/forgot-password" class="text-decoration-none">Forgot Password</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string? ErrorMessage { get; set; }

    protected  async Task OnPostAsync()
    {
        // TODO: Integrate with ApiAuthService from backend
        
        // For now, redirect to error page
        Navigation.NavigateTo("/Error", false);
    }
}
