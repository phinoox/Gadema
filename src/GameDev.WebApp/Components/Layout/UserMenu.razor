@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Sections
@rendermode InteractiveServer
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation
@inject HttpClient Http


    <div class="dropdown dropdown-user-menu" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        @* User Avatar/Initials with Circular Background *@
        <div class="d-flex align-items-center justify-content-center rounded-circle bg-light text-primary border border-2 border-light shadow-sm"
             style="width: 40px; height: 40px;"
             @onclick="ToggleMenuVisible">
            <span class="user-initials">@GetCurrentUserName()</span>
        </div>
    </div>
    @if (isMenuVisible)
    {
       
    


    <div class=" dropdown-menu-end shadow border-0" style="min-width: 280px;">
        @* User Profile Info Header *@
        <div class="p-3 bg-light border-bottom">
            <div class="d-flex align-items-center">
                @* Show avatar if available, otherwise initials *@
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                     style="width: 48px; height: 48px; font-size: 1.2rem;">
                    @GetCurrentUserName().Substring(0, Math.Min(1, (GetCurrentUserName() as string)?.Length ?? 1))
                </div>
                <div class="flex-grow-1">
                    <h6 class="mb-0">@GetCurrentUserName()</h6>
                    <small class="text-muted">@GetCurrentUserEmail() ?? "No email"</small>
                </div>
            </div>
        </div>

        @* Menu Items *@
        <div class="dropdown-divider"></div>

        @if (IsAuthenticated)
        {
            <!-- My Projects -->
            <a class="dropdown-item" href="/projects">
                <i class="bi bi-folder2-open me-2 text-primary"></i>
                My Projects
            </a>

            <!-- Content Management -->
            <a class="dropdown-item" href="/content">
                <i class="bi bi-files me-2 text-success"></i>
                Content
            </a>

            <!-- Tasks -->
            <a class="dropdown-item" href="/projecttasks">
                <i class="bi bi-check2-square me-2 text-info"></i>
                My Tasks
            </a>

            <!-- Reviews (if reviewer) -->
            <a class="dropdown-item" href="/reviews">
                <i class="bi bi-star-half me-2 text-warning"></i>
                Reviews @ReviewCountNotification
                @if (ReviewCountNotification > 0)
                {
                    <span class="badge bg-danger ms-1">@ReviewCountNotification</span>
                }
            </a>

            <!-- Dialogue & Characters -->
            <a class="dropdown-item" href="/dialogue">
                <i class="bi bi-chat-dots me-2 text-secondary"></i>
                Dialogue
            </a>

            <!-- Tags -->
            <a class="dropdown-item" href="/tags">
                <i class="bi bi-tags me-2 text-muted"></i>
                Tags
            </a>

            <!-- Search/Outline -->
            <a class="dropdown-item" href="/search">
                <i class="bi bi-search me-2 text-primary"></i>
                Search & Outline
            </a>

            <div class="dropdown-divider"></div>

            <!-- Notifications -->
            <a class="dropdown-item" href="/notifications">
                <i class="bi bi-bell me-2 text-danger"></i>
                Notifications @NotificationCountBadge
                @if (NotificationCountBadge > 0)
                {
                    <span class="badge bg-danger ms-1">@NotificationCountBadge</span>
                }
            </a>

            <!-- Profile -->
            <a class="dropdown-item" href="/settings/profile">
                <i class="bi bi-person-circle me-2 text-primary"></i>
                Profile
            </a>

            <!-- Settings -->
            <a class="dropdown-item" href="/settings">
                <i class="bi bi-gear me-2 text-secondary"></i>
                Settings
            </a>

            <!-- About -->
            <a class="dropdown-item" href="#">
                <i class="bi bi-info-circle me-2 text-info"></i>
                About GaDeMa
            </a>

            <!-- Help/Documentation -->
            <a class="dropdown-item" href="/help">
                <i class="bi bi-question-circle me-2 text-success"></i>
                Help & Documentation
            </a>

            <div class="dropdown-divider"></div>

            <!-- Sign Out -->
            <a class="dropdown-item text-danger" href="/signin">
                <i class="bi bi-box-arrow-right me-2"></i>
                Sign Out
            </a>
        }
        else
        {
            @* Show login button when not authenticated *@
            <div class="p-3">
                <a class="btn btn-primary w-100" href="/signin">
                    Sign In
                </a>
            </div>
        }

    </div>
    }


@code {
    private bool isMenuVisible = false;


    private string? CurrentUserName { get; set; }
    private string? CurrentUserEmail { get; set; }
    private int ReviewCountNotification { get; set; } // TODO: Fetch from API
    private int NotificationCountBadge { get; set; } // Mock notification count

    // Authentication state (will be determined by UserContext or HttpClient call)
    private bool IsAuthenticated { get; set; } = false;

    private void ToggleMenuVisible()
    {
        isMenuVisible = !isMenuVisible;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check authentication status via API
            var apiBaseUrl = Environment.GetEnvironmentVariable("API_BASE_URL")
                ?? "https://localhost:5001";

            // Try to get user info from API (will replace with proper auth service)
            // This is a placeholder - will be replaced by actual auth check
            // CurrentUserName = "User"; // Placeholder

            // For now, assume not authenticated until user signs in
            IsAuthenticated = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking authentication: {ex.Message}");
        }
    }

    private string GetCurrentUserName()
    {
        if (!string.IsNullOrEmpty(CurrentUserName))
            return CurrentUserName;

        // Placeholder - will be replaced with actual user info from UserContext or API
        return "User";
    }

    private string? GetCurrentUserEmail()
    {
        return null; // Will come from UserContext or API
    }

    // Event handlers for notifications (placeholder)
    [JSInvokable]
    public Task IncrementReviewNotificationAsync()
    {
        ReviewCountNotification++;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task IncrementNotificationBadgeAsync(int count)
    {
        NotificationCountBadge = count;
        return Task.CompletedTask;
    }
}

<style scoped>
    .dropdown-user-menu {
        position: relative;
    }

    .dropdown-menu {
        font-size: 0.875rem;
    }

    .dropdown-item {
        padding: 0.5rem 1rem !important;
        transition: background-color 0.2s, transform 0.2s;
    }

    .dropdown-item:hover {
        background-color: #f8f9fa !important;
        transform: translateX(4px);
    }

    .dropdown-item i {
        font-size: 1.1rem;
    }

    .dropdown-divider {
        margin: 0.5rem 0 !important;
        border-color: #dee2e6 !important;
    }

    @@media (max-width: 768px) {
        .dropdown-user-menu {
            position: static;
        }
    }
</style>
