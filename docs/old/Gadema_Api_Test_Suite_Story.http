Accept: application/json
Authorization: Bearer <ACCESS_TOKEN_FROM_STEP_2>

{
    "createData": {
        "title": "Act I: The Awakening",
        "slug": "act-i-awakening",
        "shortDesc": "Introduction to the world and main characters.",
        "status": 0,
        "isPublic": false
    },
    "storyId": "<STORY_ID_FROM_STEP_4>",
    "summary": "Elara discovers her magical abilities while exploring the ruins of her ancestral home."
}
###

